# Keep the published PHP 7.3 runtime, extensions, Oracle client, and configuration.
# The digest pins the original image so rebuilding never uses its updated 7.3 tag.
FROM thesuhu/docker-nginx-oracle-php-fpm:7.3@sha256:89055f74684ac5865672509322d0105fdf13251a9bc5655f9947c44527631c9a

ENV NGINX_VERSION=1.30.7
ARG NGINX_SHA256=2565b5c837050e958f70fb0f73c48e2bca4542ad349fd356f46fb0c72610bc6e

# Buster has no official NGINX 1.30 packages. Build against its own libraries.
# Archived Debian repositories retain signature verification; only expiry of
# the archived Release metadata is ignored.
RUN set -eux; \
    . /etc/os-release; \
    test "$ID" = debian; \
    test "$VERSION_ID" = 10; \
    test "$(php -r 'echo PHP_VERSION;')" = 7.3.33; \
    rm -f /etc/apt/sources.list.d/*.list; \
    printf '%s\n' \
        'deb [check-valid-until=no] https://archive.debian.org/debian buster main' \
        'deb [check-valid-until=no] https://archive.debian.org/debian-security buster/updates main' \
        > /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential libpcre2-dev libssl-dev zlib1g-dev; \
    curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -o /tmp/nginx.tar.gz; \
    echo "$NGINX_SHA256  /tmp/nginx.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/nginx.tar.gz -C /tmp; \
    cd "/tmp/nginx-${NGINX_VERSION}"; \
    ./configure \
        --prefix=/etc/nginx \
        --sbin-path=/usr/sbin/nginx \
        --modules-path=/usr/lib/nginx/modules \
        --conf-path=/etc/nginx/nginx.conf \
        --error-log-path=/var/log/nginx/error.log \
        --http-log-path=/var/log/nginx/access.log \
        --pid-path=/var/run/nginx.pid \
        --lock-path=/var/run/nginx.lock \
        --http-client-body-temp-path=/var/cache/nginx/client_temp \
        --http-proxy-temp-path=/var/cache/nginx/proxy_temp \
        --http-fastcgi-temp-path=/var/cache/nginx/fastcgi_temp \
        --http-uwsgi-temp-path=/var/cache/nginx/uwsgi_temp \
        --http-scgi-temp-path=/var/cache/nginx/scgi_temp \
        --user=nginx --group=nginx \
        --with-cc-opt="$(dpkg-buildflags --get CFLAGS) $(dpkg-buildflags --get CPPFLAGS)" \
        --with-ld-opt="$(dpkg-buildflags --get LDFLAGS)" \
        --with-pcre-jit \
        --with-compat --with-file-aio --with-threads \
        --with-http_addition_module \
        --with-http_auth_request_module \
        --with-http_dav_module \
        --with-http_flv_module \
        --with-http_gunzip_module \
        --with-http_gzip_static_module \
        --with-http_mp4_module \
        --with-http_random_index_module \
        --with-http_realip_module \
        --with-http_secure_link_module \
        --with-http_slice_module \
        --with-http_ssl_module \
        --with-http_stub_status_module \
        --with-http_sub_module \
        --with-http_v2_module \
        --with-mail --with-mail_ssl_module \
        --with-stream --with-stream_realip_module \
        --with-stream_ssl_module --with-stream_ssl_preread_module; \
    make -j"$(nproc)"; \
    install -m 0755 objs/nginx /usr/sbin/nginx; \
    cd /; \
    rm -rf "/tmp/nginx-${NGINX_VERSION}" /tmp/nginx.tar.gz; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    test "$(nginx -v 2>&1)" = "nginx version: nginx/${NGINX_VERSION}"; \
    nginx -t; \
    php-fpm -t; \
    php -r 'exit(extension_loaded("oci8") ? 0 : 1);'
